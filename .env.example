# GitHub Personal Access Token (PAT) used by the Copilot SDK and gh CLI.
# Sign in to GitHub and go to Settings → Developer settings → Personal access tokens.
# Grant the token the Copilot Requests permission required by your account/org.
GH_TOKEN=your_github_token_here

# TMDB API Read Access Token (v4 bearer token) is configured in the app under Settings.
# It is not required as a Docker build argument or environment variable.

# Optional: override Watchlist's isolated Copilot config/session directory.
# Defaults to ~/.copilot/watchlist-sessions (or $COPILOT_HOME/watchlist-sessions if COPILOT_HOME is set).
WATCHLIST_COPILOT_CONFIG_DIR=
